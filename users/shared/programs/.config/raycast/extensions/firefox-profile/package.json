{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "firefox-profile",
  "title": "Firefox Profiles",
  "description": "Choose and open a Firefox profile",
  "icon": "icon.png",
  "author": "baleen",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Applications",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "choose-profile",
      "title": "Choose Profile",
      "subtitle": "Firefox",
      "description": "Choose a Firefox profile from the live profile database",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.0.5",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint"
  }
}
