# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
#
# Windows side of the dotfiles: native apps. Nix does not run
# on Windows, so this is the Windows counterpart of the Darwin machine app lists.
#
#   winget configure validate -f machines/windows/configuration.winget   # static check
#   winget configure test -f machines/windows/configuration.winget       # diff against this machine
#   winget configure -f machines/windows/configuration.winget            # apply (admin terminal)
#
properties:
  configurationVersion: 0.2.0
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives:
        description: Install Visual Studio Code
      settings:
        id: Microsoft.VisualStudioCode
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: windowsTerminal
      directives:
        description: Install Windows Terminal
      settings:
        id: Microsoft.WindowsTerminal
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: discord
      directives:
        description: Install Discord
      settings:
        id: Discord.Discord
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: onePassword
      directives:
        description: Install 1Password
      settings:
        id: AgileBits.1Password
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: chrome
      directives:
        description: Install Google Chrome
      settings:
        id: Google.Chrome
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: firefox
      directives:
        description: Install Firefox
      settings:
        id: Mozilla.Firefox
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: tailscale
      directives:
        description: Install Tailscale
      settings:
        id: Tailscale.Tailscale
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: claude
      directives:
        description: Install Claude
      settings:
        id: Anthropic.Claude
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: kakaotalk
      directives:
        description: Install KakaoTalk
      settings:
        id: Kakao.KakaoTalk
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: codex
      directives:
        description: Install Codex CLI
      settings:
        id: OpenAI.Codex
        source: winget
